{{ ansible_managed | comment(decoration='# ') }}
[Unit]
Description=geo2drop: refresh firewalld ipset of country IP ranges
Documentation=https://github.com/m0zgen/geo2drop
After=network-online.target firewalld.service
Wants=network-online.target
Requires=firewalld.service

[Service]
Type=oneshot
ExecStart={{ geo2drop_bin_path }}
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
ProtectSystem=full
ProtectHome=true
NoNewPrivileges=true
PrivateTmp=true
